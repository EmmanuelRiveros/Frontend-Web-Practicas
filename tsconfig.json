{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": ".",

    "strict": true,                   // no negociable en esta materia
    "noUncheckedIndexedAccess": true,

    "esModuleInterop": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "types": ["node"]      // habilita process, console, etc.
  },
  "include": ["src/**/*"]
}
